# Шаблон окружения для leady_bot. Реальные значения держи в .env (он в .gitignore).
# Сгенерировать секреты:
#   openssl rand -hex 24   # POSTGRES_PASSWORD
#   openssl rand -hex 24   # SERVICE_API_TOKEN
#   openssl rand -hex 16   # AES_ENCRYPTION_KEY

BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
API_BASE_URL=http://api:8000
METRICS_PORT=9091
HEARTBEAT_INTERVAL_SEC=900
LICENSE_CACHE_TTL=900
PROXY_LIST=

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://leady:<тот-же-пароль>@postgres:5432/leady
SERVICE_API_TOKEN=
AES_ENCRYPTION_KEY=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
